{ #category : 'as yet unclassified' }
BioDatabases >> resolveAllUrls [
	"Resolve all remaining click_me.php URLs by following their HTTP redirects.	For each unresolved URL, follows the redirect and replaces it with the real target.	Urls that fail to resolve within 5 seconds keep the original click_me.php URL."

	databases do: [ :db |
			(db url notNil and: [ db url includesSubstring: 'click_me.php' ])
				ifTrue: [ db url: (self class resolveUrlsFor: db url) ] ].
	self
]

{ #category : 'as yet unclassified' }
BioDatabases >> resolveAllUrlsBatch: batchSize [

	| unresolved count resolved result |
	unresolved := databases select: [ :d |
		              d url notNil and: [
			              d url includesSubstring: 'click_me.php' ] ].
	unresolved ifEmpty: [ ^ 0 ].
	count := 0.
	resolved := 0.
	unresolved do: [ :db |
			count := count + 1.
			count > batchSize ifTrue: [ ^ resolved ].
			result := self class resolveUrlsFor: db url.
			(result includesSubstring: 'click_me.php') ifFalse: [
					db url: result.
					resolved := resolved + 1 ] ].
	^ resolved
]

{ #category : 'as yet unclassified' }
BioDatabases >> resolveUrls [	"Replace click_me.php proxy URLs with their resolved target URLs.	Entries whose redirect could not be resolved keep the original click_me.php URL."	| map |	map := self class resolveUrlMap.	databases do: [ :db |		(db url notNil and: [ (db url includesSubstring: 'click_me.php') ]) ifTrue: [			(map at: db url ifAbsent: [ nil ]) ifNotNil: [ :resolved |				(resolved includesSubstring: 'click_me.php') ifFalse: [ db url: resolved ] ] ] ]
]

{ #category : 'as yet unclassified' }
BioDatabases >> searchKeyword: aString [	"Answer all databases whose name or description contains aString (case-insensitive)."	| lower |	lower := aString asLowercase.	^ databases select: [ :db | (db name asLowercase includesSubstring: lower) or: [ db description asLowercase includesSubstring: lower ] ]
]

{ #category : 'as yet unclassified' }
BioDatabases >> searchName: aString [	"Answer all databases whose name contains aString (case-insensitive substring match)."	| lower |	lower := aString asLowercase.	^ databases select: [ :db | db name asLowercase includesSubstring: lower ]
]

{ #category : 'as yet unclassified' }
BioDatabases >> select: aBlock [	^ databases select: aBlock
]

{ #category : 'as yet unclassified' }
BioDatabases >> size [	^ databases size
]

{ #category : 'as yet unclassified' }
BioDatabases >> types [	"Answer a sorted collection of unique database types."	^ (databases collect: [ :db | db type ]) asSet asSortedCollection
