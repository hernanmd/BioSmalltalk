{ #category : 'accessing' }
BioDatabases class >> withAllDatabases [
	"Answer a BioDatabases instance populated with all databases from all categories."

	^ self new
		  addAllDatabases;
		  yourself
]

{ #category : 'accessing' }
BioDatabases class >> withPrimaryDatabases [
	"Answer a BioDatabases instance populated with only primary databases."

	^ self new
		  databases: self allPrimaryDatabases;
		  yourself
]

{ #category : 'accessing' }
BioDatabases class >> withSecondaryDatabases [
	"Answer a BioDatabases instance populated with only secondary databases."

	^ self new
		  databases: self allSecondaryDatabases;
		  yourself
]

