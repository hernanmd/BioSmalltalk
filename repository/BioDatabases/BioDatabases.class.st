{ #category : 'accessing' }
BioDatabases class >> categorySelectors [
	"Answer all class-side selectors that return BioDatabase collections (one per category)."

	| allSel |
	allSel := BioDatabases class selectors.
	^ allSel select: [ :s |
			  (s endsWith: 'Databases') and: [
					  #( allDatabases allPrimaryDatabases allSecondaryDatabases
					     withAllDatabases withPrimaryDatabases withSecondaryDatabases
					     categorySelectors ) noneSatisfy: [ :ex | s = ex ] ] ]
]

