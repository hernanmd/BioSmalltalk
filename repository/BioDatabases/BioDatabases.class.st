		  (BioDatabase
			   type: #secondary
			   category: 'SNP'
			   name: 'dbRIP'
			   description:
			   '"dbRIP is a highly integrated database of Retrotransposon Insertion Polymorphism (RIPs) in human."'
			   url: 'http://www.ncbi.nlm.nih.gov/Taxonomy/taxonomyhome.html/83').
		  (BioDatabase
			   type: #secondary
			   category: 'SNP'
			   name: 'TopoSNP'
			   description:
			   '"TopoSNP produces an interactive visualization of disease and non-disease associated non-synonymous single nucleotide polymorphisms (nsSNPs) and displays geometric and relative entropy calculations."'
			   url: 'http://www.ncbi.nlm.nih.gov/Taxonomy/taxonomyhome.html/84').
		  (BioDatabase
			   type: #secondary
			   category: 'SNP'
			   name: 'HGVbase'
