Class {
	#name : 'BioDatabases',
	#superclass : 'Object',
	#instVars : [
		'databases'
	],
	#category : 'BioDatabases',
	#package : 'BioDatabases'
}

{ #category : 'accessing' }
BioDatabases class >> allDatabases [
	"Answer a Collection of all BioDatabase objects from every category."

	| all |
	all := OrderedCollection new.
	self categorySelectors do: [ :sel | all addAll: (self perform: sel) ].
	^ all
]

{ #category : 'accessing' }
BioDatabases class >> allPrimaryDatabases [
	"Answer all databases of type #primary."

	^ self allDatabases select: [ :db | db type = #primary ]
]

{ #category : 'accessing' }
BioDatabases class >> allSecondaryDatabases [
	"Answer all databases of type #secondary."

	^ self allDatabases select: [ :db | db type = #secondary ]
]

