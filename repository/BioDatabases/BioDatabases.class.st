]

{ #category : 'as yet unclassified' }
BioDatabases >> byCategories: aCollection [	"Answer all databases whose category is in the given collection (case-insensitive)."	| lower |	lower := aCollection collect: [ :c | c asLowercase ].	^ databases select: [ :db | lower includes: db category asLowercase ]
]

{ #category : 'as yet unclassified' }
BioDatabases >> byCategory: aString [	"Answer all databases whose category matches aString (case-insensitive)."	^ databases select: [ :db | db category asLowercase = aString asLowercase ]
